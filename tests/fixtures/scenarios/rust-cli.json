  "identity": {
    "name": "Tidy",
    "slug": "tidy",
    "value_proposition": "Rename messy downloaded files into a consistent, sortable form.",
    "target_users": "People whose download folders fill up with files named like IMG_2041 (3).JPG.",
    "requirements": [
      {
        "id": "R1",
        "text": "A user can rename every file in a folder to a date-prefixed, lowercase, hyphenated name.",
        "acceptance": "Given a folder with files named 'IMG 2041 (3).JPG', when the user runs tidy on it, then the file is renamed to '2026-10-23-img-2041-3.jpg' and nothing else changes."
      }
    ],
