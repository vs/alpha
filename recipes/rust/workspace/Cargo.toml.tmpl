# The workspace of this repository's Rust components. Every dependency's
# version is pinned here, under [workspace.dependencies], and nowhere else: a
# member names it as `foo.workspace = true`. A member that uses a sibling
# component names its folder: `foo = { path = "../foo" }`.
[workspace]
members = [$members]
resolver = "3"

[workspace.package]
edition = "2024"
version = "0.1.0"
publish = false

[workspace.dependencies]

[workspace.lints.rust]
unsafe_code = "forbid"

# `cargo clippy -- -D warnings` fails on each of these; builds and tests only
# warn, so work in progress still compiles.
[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
# Errors say what went wrong: no `unwrap()` outside tests (clippy.toml), and
# an `expect()` names the invariant that makes it safe.
unwrap_used = "warn"
dbg_macro = "warn"
todo = "warn"
# A suppression is `#[expect(lint, reason = "…")]`, which fails once it's stale.
allow_attributes = "warn"
allow_attributes_without_reason = "warn"
