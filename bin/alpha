#!/usr/bin/env python3
"""alpha CLI shim. Keep this file Python 3.9-compatible so the version check can run."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "src"))

from alpha.pyguard import check_python  # noqa: E402

problem = check_python(sys.version_info[:2])
if problem:
    print(problem, file=sys.stderr)
    sys.exit(1)

from alpha.cli import main  # noqa: E402

sys.exit(main())
